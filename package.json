{
  "name": "ai-assistant-template",
  "version": "1.0.0",
  "description": "AI assistant backend: answers only from your own facts, model fallback, safe JSON parsing.",
  "type": "module",
  "license": "MIT",
  "author": "Vertex Code by Ȥrk Team",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "@hono/node-server": "^1.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
